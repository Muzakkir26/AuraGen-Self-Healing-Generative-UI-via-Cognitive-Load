# Copy to .env and fill in real values. Never commit .env.

# LLM provider (final choice pending)
# LLM_PROVIDER=mock works with no API key (deterministic wizard generator for demos and tests).
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
LLM_TIMEOUT_MS=15000
LLM_TEMPERATURE=0.2
GENERATION_CACHE_TTL_MS=600000

# Backend
PORT=4000
WS_PATH=/ws

# Friction engine tuning
LOAD_HIGH_THRESHOLD=70
LOAD_TRIGGER_HOLD_MS=3000
GENERATION_COOLDOWN_MS=30000

# Frontend
NEXT_PUBLIC_TELEMETRY_WS_URL=ws://localhost:5000/ws/telemetry
NEXT_PUBLIC_SHOW_DEBUG=false
